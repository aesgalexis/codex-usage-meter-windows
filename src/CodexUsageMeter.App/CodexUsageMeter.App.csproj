<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>CodexUsageMeter.App.Program</StartupObject>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <AssemblyName>CodexUsageMeter</AssemblyName>
    <AssemblyTitle>Codex Usage Meter for Windows</AssemblyTitle>
    <Product>Codex Usage Meter for Windows</Product>
    <Description>Windows tray app for viewing local Codex usage limits.</Description>
    <Authors>aesgalexis and contributors</Authors>
    <Copyright>Copyright © 2026 Codex Usage Meter contributors</Copyright>
    <Version>0.1.0</Version>
    <RepositoryUrl>https://github.com/aesgalexis/codex-usage-meter-windows</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodexUsageMeter.Core\CodexUsageMeter.Core.csproj" />
    <ProjectReference Include="..\CodexUsageMeter.Infrastructure\CodexUsageMeter.Infrastructure.csproj" />
  </ItemGroup>
</Project>
